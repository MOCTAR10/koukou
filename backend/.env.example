# Copy to .env and fill in. Every variable has a default except JWT_SECRET and
# PROGRAM_CODE (mandatory), and TRACE_QR_SECRET / TRACE_PUBLIC_BASE_URL in
# production.

# --- Server ---
PORT=3000
SWAGGER_PATH=api-docs
# Swagger is on by default, off when NODE_ENV=production. true/false overrides.
# SWAGGER_ENABLED=false
# Number of reverse proxies in front of the API (nginx, load balancer...). Required
# behind a proxy, or all clients share one login rate limit. Unset = none, and
# X-Forwarded-For is ignored. Too high a value lets clients forge their IP.
# TRUST_PROXY=1
# Comma-separated list of allowed origins; '*' allows all (dev only).
# Mandatory in production (no wildcard default); * only for local dev.
CORS_ORIGINS=*

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=koukou_ferme
# The schema comes from versioned migrations (src/database/migrations), run at boot.
DB_MIGRATIONS_RUN=true
# Local escape hatch only: true rebuilds the schema from the entities at boot
# (irreversible column drops). Keep false; never true in a deployed environment.
DB_SYNCHRONIZE=false

# --- Auth ---
# REQUIRED in any shared environment. Without it a random secret is generated
# at each boot and every session is invalidated on restart.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Platform admin seed (optional; absent = no admin created) ---
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PHONE=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=Administrateur Plateforme

# --- Programme (POUFA) ---
# REQUIRED: code of the public programme this instance serves. The app refuses
# to start without it. Every farm belongs to it (created by the registry,
# POST /programme/farms). The programme, its provinces, lists, default
# parameters and access profiles are seeded at boot (idempotent, never
# overwriting). The migration CLI does not need it.
PROGRAM_CODE=POUFA
# Institutional accounts (INSTITUTION role): one-time SMS code at login.
# off (default, no SMS provider live yet) = login code only; sms = login code
# then a 6-digit code sent by SMS (POST /auth/login/otp). 8 h session either way.
# INSTITUTION_OTP=off

# --- Traceability (POUFA lots, signed QR codes) ---
# REQUIRED in production (the app refuses to start without it): key signing the
# lots' QR codes and hashing the scanners' IPs. Keep it secret and stable:
# printed labels keep the signature made at their creation, so changing the
# key only affects lots created afterwards.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset outside production = fixed development key (QR codes not protected).
TRACE_QR_SECRET=
# REQUIRED in production: public address of the web app, start of every QR
# address (<base>/l/<code>?s=<signature>). Default http://localhost:5400.
# TRACE_PUBLIC_BASE_URL=https://poufa.ga
# Link of the « Consommons Gabonais » mention on the public lot page.
# Default <TRACE_PUBLIC_BASE_URL>/consommons-gabonais.
# TRACE_CONSOMMONS_GABONAIS_URL=

# --- SMS ---
# console (default: the SMS is written to the server log, development only).
# airtel and moov are reserved: they refuse to boot until their adapter exists.
# SMS_PROVIDER=console

# --- Files ---
# Farm logo uploads directory (default: backend/uploads)
# UPLOADS_DIR=

# Never set in a deployed environment (disables rate limiting; e2e only).
# THROTTLE_DISABLED=true

# Hourly overdue-task sweep (raises/clears the TACHE alert). On by default;
# e2e sets it to true. Keep it on in production.
# TASK_SWEEP_DISABLED=true

# Hourly Market sweep (expires unanswered requests and unpaid deposits). On by
# default; e2e sets it to true. Keep it on in production.
# MARKET_SWEEP_DISABLED=true

# Hourly POUFA band sweep (late weighings → WEIGHING_LATE, projection of
# untouched bands extended to today). On by default; e2e sets it to true.
# WEIGHING_SWEEP_DISABLED=true

# Notification sweep, every minute (escalation of unread notifications to SMS,
# SMS sends and retries). On by default; e2e sets it to true. Keep it on in
# production.
# NOTIFY_SWEEP_DISABLED=true

# Daily seal of the audit journal (runs at boot and hourly). On by default;
# e2e sets it to true. Never disable it in production (docs/audit-deploiement.md).
# AUDIT_SEAL_DISABLED=true

# Hourly scheduled PDF reports of the programme (weekly per province, national
# monthly, end of band → REPORT_READY). On by default; e2e sets it to true.
# REPORT_SWEEP_DISABLED=true

# --- Server push (Expo Push service) ---
# Optional: Expo access token if "enhanced push security" is on for the project.
# EXPO_ACCESS_TOKEN=
# Skip the network call to Expo (e2e sets it). Devices are still registered.
# PUSH_DISABLED=true

# Account lockout (CDC 8.1): consecutive failed logins before a lock, lock duration.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
