# /opt/fermia/.env on the server (chmod 600). Never commit the real file.
NODE_ENV=production
TRUST_PROXY=1
CORS_ORIGINS=https://fermia.greenleaves.ga
DB_PASSWORD=
JWT_SECRET=
TRACE_QR_SECRET=
TRACE_PUBLIC_BASE_URL=https://fermia.greenleaves.ga
PROGRAM_CODE=POUFA
DB_MIGRATIONS_RUN=true
DB_SYNCHRONIZE=false
# Public Swagger at https://fermia.greenleaves.ga/api/docs (nginx strips /api/).
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
# Audit roles (deploy/audit-roles.sql, CDC 8.7). Once set, the API connects as
# fermia_app (no UPDATE/DELETE on the journal) and deploy.sh runs the
# migrations as fermia_owner; then set DB_MIGRATIONS_RUN=false above.
# DB_APP_USER=fermia_app
# DB_APP_PASSWORD=
# DB_OWNER_PASSWORD=
