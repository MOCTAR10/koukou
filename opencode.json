{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "model": "opencode/sonic",
  "smallModel": "opencode/grok-4-fast",
  "agent": {
    "build": {
      "model": "opencode/sonic",
      "maxSteps": 25,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow",
          "scout": "allow"
        }
      }
    },
    "plan": {
      "model": "opencode/sonic",
      "maxSteps": 12,
      "permission": {
        "task": {
          "*": "deny",
          "explore": "allow"
        }
      }
    }
  },
  "subagentDepth": 1
}
